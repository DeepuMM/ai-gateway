<fragment>
  <!-- Shared by every project API, inbound. Deployed by gateway-policy-deployment (one copy per APIM).
       Reads the context variables set by templates/project-policy.xml:
         project-rate   calls per minute per consumer across all agents of the project (int)
       The project's daily quota is in the project policy itself: quota-by-key accepts no policy expression in calls. -->

  <!-- Project rate limit per consumer, across all agents in the project. -->
  <rate-limit-by-key calls="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;project-rate&quot;, 0))" renewal-period="60"
      counter-key="@((context.Subscription?.Id ?? context.Request.IpAddress) + &quot;|project&quot;)"
      remaining-calls-header-name="x-ratelimit-remaining-project" retry-after-header-name="Retry-After" />
  <!-- One correlation ID per call: the caller's x-correlation-id, else the trace ID of its W3C traceparent, else the
       gateway's request ID. Sent to Foundry and returned to the caller (project-outbound). traceparent and tracestate
       are passed on untouched, so the caller's trace continues through the gateway into the agent. -->
  <set-variable name="correlation-id" value="@{
    var caller = context.Request.Headers.GetValueOrDefault(&quot;x-correlation-id&quot;, &quot;&quot;);
    if (!string.IsNullOrEmpty(caller)) { return caller; }
    var parts = context.Request.Headers.GetValueOrDefault(&quot;traceparent&quot;, &quot;&quot;).Split('-');
    if (parts.Length == 4 &amp;&amp; parts[1].Length == 32) { return parts[1]; }
    return context.RequestId.ToString();
  }" />
  <set-header name="x-correlation-id" exists-action="override">
    <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlation-id"))</value>
  </set-header>
  <!-- Every agent operation goes to the project's Responses API. -->
  <rewrite-uri template="/openai/v1/responses" copy-unmatched-params="false" />
  <!-- APIM, not the caller, authenticates to Foundry; the caller's key is not passed on. -->
  <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
  <authentication-managed-identity resource="https://ai.azure.com" />
</fragment>
